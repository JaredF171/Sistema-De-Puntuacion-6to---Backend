# Ejemplo de variables de entorno para desarrollo
# Copia este archivo a `.env` y ajústalo antes de ejecutar `docker-compose up`.

# MySQL / MariaDB
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=evaluacion360
MYSQL_USER=evaluacion_user
MYSQL_PASSWORD=123456789

# Django (las variables DB_* son usadas por `config/settings.py` cuando DB_ENGINE=mysql)
DB_ENGINE=mysql
DB_NAME=evaluacion360
DB_USER=evaluacion_user
DB_PASS=123456789
DB_HOST=db
DB_PORT=3306

# Clave secreta de Django (no usar en producción tal cual)
SECRET_KEY=dev-secret

# DEBUG puede ser True/False
DEBUG=True
